# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase dashboard → Project Settings → API.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used for admin tasks (optional for now). NEVER prefix with NEXT_PUBLIC.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app (used for auth redirects). Local default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Improves page-count/year backfill coverage (Google Books fallback).
# Works without a key at low volume; add one to raise rate limits.
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key
