# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase dashboard → Project Settings → API.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use your project's publishable key (sb_publishable_...). Newer Supabase
# projects call it "publishable"; older ones call it "anon". Either var works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key  # legacy alternative

# Server-only. Used for admin tasks (optional for now). NEVER prefix with NEXT_PUBLIC.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Postgres connection string for running migrations (npm run db:migrate).
# Supabase dashboard → Connect → "Session pooler" URI (port 5432). Contains your DB password.
# Lives only in .env.local (gitignored) — never committed.
# SUPABASE_DB_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Base URL of the app (used for auth redirects). Local default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Improves page-count/year backfill coverage (Google Books fallback).
# Works without a key at low volume; add one to raise rate limits.
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key
